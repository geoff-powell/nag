{
  "schema": 1,
  "description": "Escalation interval and next tightening point. Durations are in seconds. Swift NagCore is the reference. Each case's input is also the request body for the KMP prototype's JSON bridge. nextTighteningSeconds is null when the interval no longer shrinks.",
  "cases": [
    { "name": "steady keeps the base interval",
      "input": { "op": "escalation", "mode": "steady", "baseSeconds": 900, "overdueSeconds": 0 },
      "expect": { "intervalSeconds": 900, "nextTighteningSeconds": null } },
    { "name": "steady ignores how long the nag is overdue",
      "input": { "op": "escalation", "mode": "steady", "baseSeconds": 900, "overdueSeconds": 36000 },
      "expect": { "intervalSeconds": 900, "nextTighteningSeconds": null } },
    { "name": "base under a minute is clamped to a minute",
      "input": { "op": "escalation", "mode": "steady", "baseSeconds": 0, "overdueSeconds": 0 },
      "expect": { "intervalSeconds": 60, "nextTighteningSeconds": null },
      "skip": { "csharp": "Reminder.IntervalMinutes must be whole minutes in 1...1440" } },
    { "name": "gentle before the nag is due treats overdue as zero",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 960, "overdueSeconds": -600 },
      "expect": { "intervalSeconds": 960, "nextTighteningSeconds": 3600 } },
    { "name": "gentle at the start",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 960, "overdueSeconds": 0 },
      "expect": { "intervalSeconds": 960, "nextTighteningSeconds": 3600 } },
    { "name": "gentle one second before the first step",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 960, "overdueSeconds": 3599 },
      "expect": { "intervalSeconds": 960, "nextTighteningSeconds": 3600 } },
    { "name": "gentle exactly at the first step",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 960, "overdueSeconds": 3600 },
      "expect": { "intervalSeconds": 720, "nextTighteningSeconds": 7200 } },
    { "name": "gentle second step",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 960, "overdueSeconds": 7200 },
      "expect": { "intervalSeconds": 540, "nextTighteningSeconds": 10800 } },
    { "name": "gentle reaches its floor of half the base",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 960, "overdueSeconds": 10800 },
      "expect": { "intervalSeconds": 480, "nextTighteningSeconds": null } },
    { "name": "gentle stays at its floor after 50 days",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 960, "overdueSeconds": 4320000 },
      "expect": { "intervalSeconds": 480, "nextTighteningSeconds": null } },
    { "name": "gentle produces fractional seconds",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 900, "overdueSeconds": 7200 },
      "expect": { "intervalSeconds": 506.25, "nextTighteningSeconds": 10800 } },
    { "name": "gentle with a one minute base never tightens",
      "input": { "op": "escalation", "mode": "gentle", "baseSeconds": 60, "overdueSeconds": 0 },
      "expect": { "intervalSeconds": 60, "nextTighteningSeconds": null } },
    { "name": "relentless at the start",
      "input": { "op": "escalation", "mode": "relentless", "baseSeconds": 960, "overdueSeconds": 0 },
      "expect": { "intervalSeconds": 960, "nextTighteningSeconds": 1800 } },
    { "name": "relentless halves every 30 minutes",
      "input": { "op": "escalation", "mode": "relentless", "baseSeconds": 960, "overdueSeconds": 1800 },
      "expect": { "intervalSeconds": 480, "nextTighteningSeconds": 3600 } },
    { "name": "relentless third step",
      "input": { "op": "escalation", "mode": "relentless", "baseSeconds": 960, "overdueSeconds": 5400 },
      "expect": { "intervalSeconds": 120, "nextTighteningSeconds": 7200 } },
    { "name": "relentless reaches the one minute floor",
      "input": { "op": "escalation", "mode": "relentless", "baseSeconds": 960, "overdueSeconds": 7200 },
      "expect": { "intervalSeconds": 60, "nextTighteningSeconds": null } },
    { "name": "relentless stays at a minute after 50 days",
      "input": { "op": "escalation", "mode": "relentless", "baseSeconds": 960, "overdueSeconds": 4320000 },
      "expect": { "intervalSeconds": 60, "nextTighteningSeconds": null } },
    { "name": "relentless produces fractional minutes",
      "input": { "op": "escalation", "mode": "relentless", "baseSeconds": 900, "overdueSeconds": 1800 },
      "expect": { "intervalSeconds": 450, "nextTighteningSeconds": 3600 } }
  ]
}
