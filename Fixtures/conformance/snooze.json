    { "name": "snooze ending exactly now is no longer active",
      "input": { "op": "snooze", "now": 1793178000000,
        "task": { "startAt": 1793174400000, "completed": false, "snoozeMinutes": 10, "maxSnoozes": 3, "snoozeCount": 1, "snoozedUntil": 1793178000000 } },
      "expect": { "canSnooze": true,
        "task": { "startAt": 1793174400000, "completed": false, "snoozeMinutes": 10, "maxSnoozes": 3, "snoozeCount": 2, "snoozedUntil": 1793178600000 } } },
    { "name": "unlimited snoozes keep counting",
      "input": { "op": "snooze", "now": 1793178000000,
