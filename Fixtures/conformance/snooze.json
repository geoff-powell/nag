      "skip": { "csharp": "Reminder.MaxSnoozes is an int in 0...100 and cannot be unlimited" } },
    { "name": "snooze length comes from the nag",
      "input": { "op": "snooze", "now": 1793178000000,
        "task": { "startAt": 1793174400000, "completed": false, "snoozeMinutes": 60, "maxSnoozes": 3, "snoozeCount": 0, "snoozedUntil": null } },
      "expect": { "canSnooze": true,
        "task": { "startAt": 1793174400000, "completed": false, "snoozeMinutes": 60, "maxSnoozes": 3, "snoozeCount": 1, "snoozedUntil": 1793181600000 } } },
    { "name": "completing a snoozed one-off resets the snooze",
      "input": { "op": "complete", "now": 1793178000000,
        "task": { "startAt": 1793174400000, "completed": false, "snoozeMinutes": 10, "maxSnoozes": 3, "snoozeCount": 2, "snoozedUntil": 1793178300000 } },
      "expect": {
        "task": { "startAt": 1793174400000, "completed": true, "snoozeMinutes": 10, "maxSnoozes": 3, "snoozeCount": 0, "snoozedUntil": null } } }
