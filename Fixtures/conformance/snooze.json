      "expect": { "canSnooze": true,
        "task": { "startAt": 1793174400000, "completed": false, "snoozeMinutes": 10, "maxSnoozes": 3, "snoozeCount": 1, "snoozedUntil": 1793178600000 } } },
    { "name": "nag due exactly now can be snoozed",
      "input": { "op": "snooze", "now": 1793178000000,
        "task": { "startAt": 1793178000000, "completed": false, "snoozeMinutes": 10, "maxSnoozes": 3, "snoozeCount": 0, "snoozedUntil": null } },
      "expect": { "canSnooze": true,
        "task": { "startAt": 1793178000000, "completed": false, "snoozeMinutes": 10, "maxSnoozes": 3, "snoozeCount": 1, "snoozedUntil": 1793178600000 } } },
    { "name": "nag that is not due yet cannot be snoozed",
      "input": { "op": "snooze", "now": 1793178000000,
