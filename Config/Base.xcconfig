// Shared by every target. Target-specific settings live in the project file.
#include "Signing.xcconfig"

APP_GROUP_ID = group.$(NAG_BUNDLE_ID)

IPHONEOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
CODE_SIGN_STYLE = Automatic

// Mac app signing. Locally Xcode manages it. CI can't (every runner is a new, unregistered Mac),
// so scripts/release-mac.sh switches these to manual Developer ID signing.
NAG_MAC_CODE_SIGN_STYLE = Automatic
NAG_MAC_SIGN_IDENTITY = Apple Development
NAG_MAC_PROFILE =
MARKETING_VERSION = 1.0
// Release scripts override this with a timestamp, so every upload gets a new build number.
CURRENT_PROJECT_VERSION = 1
// Nag only hashes key IDs (SHA-256), which is exempt from export compliance.
INFOPLIST_KEY_ITSAppUsesNonExemptEncryption = NO

ALWAYS_SEARCH_USER_PATHS = NO
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = YES
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_PREVIEWS = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
GCC_C_LANGUAGE_STANDARD = gnu17
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES
